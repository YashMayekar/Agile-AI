{
  "type": "object",
  "required": ["message", "actions"],
  "properties": {
    "message": { "type": "string" },

    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["create_file", "update_file", "delete_file"]
          },
          "path": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },

    "stateUpdates": {
      "type": "object"
    },

    "meta": {
      "type": "object"
    }
  }
}
