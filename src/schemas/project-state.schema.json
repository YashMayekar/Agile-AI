{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "projectId",
    "mode",
    "phase",
    "currentStepId",
    "workflowFile",
    "documents",
    "completedSteps",
    "history",
    "contextMemory",
    "dynamicContext"
  ],
  "properties": {
    "projectId": { "type": "string" },
    "mode": { "type": "string", "enum": ["greenfield", "brownfield"] },
    "phase": { "type": "string", "enum": ["planning", "implementation"] },
    "currentStepId": { "anyOf": [ { "type": "number" }, { "type": "string" }, { "type": "null" } ] },
    "workflowFile": { "type": "string" },
    "documents": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/ProjectDocument" }
    },
    "completedSteps": {
      "type": "array",
      "items": { "anyOf": [ { "type": "number" }, { "type": "string" } ] }
    },
    "history": {
      "type": "array",
      "items": { "$ref": "#/definitions/ProjectHistoryEntry" }
    },
    "contextMemory": { "$ref": "#/definitions/ContextMemory" },
    "dynamicContext": { "$ref": "#/definitions/DynamicContext" }
  },
  "definitions": {
    "ProjectDocument": {
      "type": "object",
      "required": ["status", "version", "updatedAt"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "version": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ProjectHistoryEntry": {
      "type": "object",
      "required": ["stepId", "agent", "timestamp", "summary"],
      "properties": {
        "stepId": { "anyOf": [ { "type": "number" }, { "type": "string" } ] },
        "agent": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "summary": { "type": "string" }
      }
    },
    "ContextMemory": {
      "type": "object",
      "required": ["summary", "decisions", "architectureNotes"],
      "properties": {
        "summary": { "type": "string" },
        "decisions": { "type": "array", "items": { "type": "string" } },
        "architectureNotes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "FileNode": {
      "type": "object",
      "required": ["file"],
      "properties": { "file": { "type": "string" } },
      "additionalProperties": false
    },
    "DirectoryNode": {
      "type": "object",
      "required": ["directory", "children"],
      "properties": {
        "directory": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/FileTreeNode" }
        }
      },
      "additionalProperties": false
    },
    "FileTreeNode": {
      "oneOf": [
        { "$ref": "#/definitions/FileNode" },
        { "$ref": "#/definitions/DirectoryNode" }
      ]
    },
    "DynamicContext": {
      "type": "object",
      "required": ["currentStoryIndex"],
      "properties": {
        "stories": { "type": "array", "items": { "type": "string" } },
        "currentStoryIndex": { "type": "number" },
        "qaLeftUnchecked": { "type": "boolean" },
        "fileTree": { "$ref": "#/definitions/FileTreeNode" }
      },
      "additionalProperties": true
    }
  }
}