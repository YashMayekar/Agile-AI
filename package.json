{
  "name": "agile-ai-backend",
  "version": "1.0.0",
  "description": "Agile AI Orchestration Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cpx \"src/workflows/**/*\" dist/workflows && cpx \"src/schemas/**/*\" dist/schemas && cpx \"src/templates/**/*\" dist/templates && cpx \"src/agents/prompts/**/*\" dist/agents/prompts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "js-yaml": "^4.1.1",
    "uuid": "^9.0.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.5.0",
    "@types/uuid": "^10.0.0",
    "cpx": "^1.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
